{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AI TrustBOM",
          "version": "1.0.0",
          "informationUri": "https://github.com/resolveinterim/AI.TrustBOM"
        }
      },
      "results": [
        {
          "ruleId": "subprocessor-undeclared",
          "level": "warning",
          "message": {
            "text": "Provider \u0027openai\u0027 has no declared subprocessor."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "trust/manual.yml"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 9
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
